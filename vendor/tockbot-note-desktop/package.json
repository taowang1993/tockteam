{
  "name": "tockbot-note-desktop",
  "version": "0.1.2",
  "description": "Caller-bound TockTutor native actions adapter for TockTeam Desktop",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "node": "./dist/client-api.js",
      "browser": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./typert": {
      "types": "./dist/typert.host.d.ts",
      "default": "./dist/typert.host.js"
    },
    "./remote": {
      "types": "./dist/typert.remote-client.d.ts",
      "default": "./dist/typert.remote-client.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "cordis.patch.yml",
    "dist",
    "package.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@tockteam/desktop",
        "@tockteam/tocktutor-workbench"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.5",
    "@deepseek-ai/dsh-typert-protocol": "0.1.0-rc.5",
    "@tockteam/desktop": ">=0.1.11 <0.2.0",
    "@tockteam/tocktutor-workbench": "0.1.7",
    "react": "^18.2.0",
    "tockbot-note-runtime": "0.1.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-include": "1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.5",
    "@deepseek-ai/dsh-typert-generator": "0.1.0-rc.5",
    "@deepseek-ai/dsh-typert-protocol": "0.1.0-rc.5",
    "@tockteam/desktop": "0.1.11",
    "@tockteam/tocktutor-workbench": "0.1.7",
    "@types/node": "22.20.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "esbuild": "0.25.12",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tockbot-note-runtime": "0.1.2",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "scripts": {
    "build": "node scripts/generate-typert.mjs && tsc -p tsconfig.build.json && node scripts/build-client.mjs",
    "test": "pnpm run build && node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  }
}