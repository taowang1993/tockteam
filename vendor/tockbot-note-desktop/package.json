{
  "name": "tockbot-note-desktop",
  "version": "0.1.0",
  "description": "Desktop-only DSH composition guard for TockTutor native services",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "node": "./dist/client-api.js",
      "browser": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "cordis.patch.yml",
    "dist",
    "package.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@tockteam/desktop",
        "@tockteam/tocktutor-workbench"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.5",
    "@tockteam/desktop": ">=0.1.6 <0.2.0",
    "@tockteam/tocktutor-workbench": "0.1.4",
    "tockbot-note-runtime": "0.1.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-include": "1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.5",
    "@tockteam/desktop": "0.1.6",
    "@tockteam/tocktutor-workbench": "0.1.4",
    "@types/node": "22.20.0",
    "esbuild": "0.25.12",
    "tockbot-note-runtime": "0.1.2",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-client.mjs",
    "test": "pnpm run build && node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  }
}