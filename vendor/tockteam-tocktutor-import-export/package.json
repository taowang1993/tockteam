{
  "name": "@tockteam/tocktutor-import-export",
  "version": "0.1.1",
  "description": "Reviewed TockTutor import, backup, restore, conversion, and export Host/client package",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client-api.d.ts",
      "node": "./dist/client-api.js",
      "browser": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./remote": {
      "types": "./dist/typert.remote-client.d.ts",
      "default": "./dist/typert.remote-client.js"
    },
    "./typert": {
      "types": "./dist/typert.host.d.ts",
      "default": "./dist/typert.host.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "cordis.patch.yml",
    "dist"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@tockteam/tocktutor-workbench"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-typert-protocol": "0.1.0-rc.5",
    "@tockteam/desktop": ">=0.1.11 <0.2.0",
    "@tockteam/tocktutor-workbench": ">=0.1.7 <0.2.0",
    "react": "^18.2.0",
    "tockbot-note-runtime": "0.1.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-include": "1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@deepseek-ai/dsh-client-runtime": "link:/Users/max/dsh/tockteam/.cache/dsh-source/47f943859bef/packages/client/runtime",
    "@deepseek-ai/dsh-client-ui-slots": "link:/Users/max/dsh/tockteam/.cache/dsh-source/47f943859bef/packages/client/ui-slots",
    "@deepseek-ai/dsh-typert-generator": "link:/Users/max/dsh/tockteam/.cache/dsh-source/47f943859bef/packages/typert/generator",
    "@deepseek-ai/dsh-typert-protocol": "link:/Users/max/dsh/tockteam/.cache/dsh-source/47f943859bef/packages/typert/protocol",
    "@tockteam/desktop": "file:/Users/max/dsh/tockteam/tockteam-desktop-0.1.11.tgz",
    "@tockteam/tocktutor-workbench": "file:/Users/max/dsh/tockbot-note-workbench/tockteam-tocktutor-workbench-0.1.7.tgz",
    "@types/node": "22.20.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "esbuild": "0.25.12",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tockbot-note-runtime": "file:/Users/max/dsh/tockbot-note-runtime/tockbot-note-runtime-0.1.2.tgz",
    "tockbot-note-vault": "file:/Users/max/dsh/tockteam/vendor/tockbot-note-vault-0.6.0.tgz",
    "typescript": "6.0.3"
  },
  "scripts": {
    "build": "pnpm run generate:typert && tsc -p tsconfig.build.json && node scripts/build-client.mjs",
    "generate:typert": "node scripts/generate-typert.mjs",
    "test": "pnpm run build && pnpm run typecheck && pnpm run test:unit",
    "test:contract": "node --test tests/desktop-host-contract.test.ts",
    "test:unit": "node --test --test-concurrency=1 tests/*.test.ts",
    "typecheck": "pnpm run generate:typert && tsc -p tsconfig.json"
