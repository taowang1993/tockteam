{
  "name": "@tockteam/note-vault-tools",
  "version": "0.1.2",
  "description": "Host-only DSH tools for the active TockTutor note vault",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "tockbot-note-runtime": "0.1.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@types/node": "22.20.0",
    "tockbot-note-runtime": "0.1.2",
    "tockbot-note-vault": "0.6.0",
    "typescript": "6.0.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  }
}