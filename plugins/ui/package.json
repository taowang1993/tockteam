{
  "name": "@tockteam/ui",
  "version": "0.1.0",
  "description": "Shared shadcn source components for TockTeam browser surfaces",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "browser": "./src/index.ts",
      "node": "./lib/index.js",
      "default": "./src/index.ts"
    },
    "./alert": { "types": "./src/alert.tsx", "browser": "./src/alert.tsx", "node": "./lib/index.js", "default": "./src/alert.tsx" },
    "./badge": { "types": "./src/badge.tsx", "browser": "./src/badge.tsx", "node": "./lib/index.js", "default": "./src/badge.tsx" },
    "./button": { "types": "./src/button.tsx", "browser": "./src/button.tsx", "node": "./lib/index.js", "default": "./src/button.tsx" },
    "./card": { "types": "./src/card.tsx", "browser": "./src/card.tsx", "node": "./lib/index.js", "default": "./src/card.tsx" },
    "./checkbox": { "types": "./src/checkbox.tsx", "browser": "./src/checkbox.tsx", "node": "./lib/index.js", "default": "./src/checkbox.tsx" },
    "./dialog": { "types": "./src/dialog.tsx", "browser": "./src/dialog.tsx", "node": "./lib/index.js", "default": "./src/dialog.tsx" },
    "./empty": { "types": "./src/empty.tsx", "browser": "./src/empty.tsx", "node": "./lib/index.js", "default": "./src/empty.tsx" },
    "./input": { "types": "./src/input.tsx", "browser": "./src/input.tsx", "node": "./lib/index.js", "default": "./src/input.tsx" },
    "./label": { "types": "./src/label.tsx", "browser": "./src/label.tsx", "node": "./lib/index.js", "default": "./src/label.tsx" },
    "./native-select": { "types": "./src/native-select.tsx", "browser": "./src/native-select.tsx", "node": "./lib/index.js", "default": "./src/native-select.tsx" },
    "./skeleton": { "types": "./src/skeleton.tsx", "browser": "./src/skeleton.tsx", "node": "./lib/index.js", "default": "./src/skeleton.tsx" },
    "./spinner": { "types": "./src/spinner.tsx", "browser": "./src/spinner.tsx", "node": "./lib/index.js", "default": "./src/spinner.tsx" },
    "./switch": { "types": "./src/switch.tsx", "browser": "./src/switch.tsx", "node": "./lib/index.js", "default": "./src/switch.tsx" },
    "./textarea": { "types": "./src/textarea.tsx", "browser": "./src/textarea.tsx", "node": "./lib/index.js", "default": "./src/textarea.tsx" },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-switch": "1.3.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.473.0"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/react": "~18.3.1",
    "esbuild": "0.25.12",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^6.0.3"
  }
}
