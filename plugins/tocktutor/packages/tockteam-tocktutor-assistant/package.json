{
  "name": "@tockteam/tocktutor-assistant",
  "version": "0.1.5",
  "description": "Inline TockTutor assistant with runtime-backed reads and staged writes",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client-bundle.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "PENNIVO_PROVENANCE.md",
    "THIRD_PARTY_NOTICES"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@tockteam/tocktutor-workbench"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "pnpm run generate:typert && tsc -p tsconfig.build.json && node scripts/build-client.mjs",
    "generate:typert": "node scripts/generate-typert.mjs",
    "test": "pnpm run build && node --test --test-concurrency=1 tests/*.test.ts && pnpm run test:component",
    "test:component": "vitest run tests/*.test.tsx --environment jsdom",
    "typecheck": "pnpm run generate:typert && tsc --noEmit",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.5",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.5",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.5",
    "@deepseek-ai/dsh-session": "0.1.0-rc.5",
    "@deepseek-ai/dsh-settings": "0.1.0-rc.5",
    "@deepseek-ai/dsh-storage-domain": "0.1.0-rc.5",
    "@deepseek-ai/dsh-subprocess": "0.1.0-rc.5",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.5",
    "@deepseek-ai/dsh-typert-protocol": "0.1.0-rc.5",
    "@tockteam/tocktutor-workbench": "0.1.7",
    "react": "^18.2.0",
    "tockbot-note-runtime": "0.1.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1",
    "@pennivo/mcp-server": "1.4.0",
    "lucide-react": "0.473.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-include": "1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.5",
    "@deepseek-ai/dsh-api-gateway": "0.1.0-rc.5",
    "@deepseek-ai/dsh-client-connection": "0.1.0-rc.5",
    "@deepseek-ai/dsh-client-modules": "0.1.0-rc.5",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.5",
    "@deepseek-ai/dsh-host-webserver": "0.1.0-rc.5",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.5",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.5",
    "@deepseek-ai/dsh-session": "0.1.0-rc.5",
    "@deepseek-ai/dsh-settings": "0.1.0-rc.5",
    "@deepseek-ai/dsh-storage": "0.1.0-rc.5",
    "@deepseek-ai/dsh-storage-domain": "0.1.0-rc.5",
    "@deepseek-ai/dsh-storage-json": "0.1.0-rc.5",
    "@deepseek-ai/dsh-subprocess": "0.1.0-rc.5",
    "@deepseek-ai/dsh-subprocess-local": "0.1.0-rc.5",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.5",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.5",
    "@deepseek-ai/dsh-typert-generator": "0.1.0-rc.5",
    "@deepseek-ai/dsh-typert-protocol": "0.1.0-rc.5",
    "@deepseek-ai/dsh-typert-registry": "0.1.0-rc.5",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@tockteam/desktop": "workspace:*",
    "@tockteam/tocktutor-workbench": "workspace:0.1.7",
    "@tockteam/ui": "workspace:*",
    "@types/node": "22.20.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "esbuild": "0.25.12",
    "jsdom": "29.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tockbot-note-runtime": "workspace:0.1.2",
    "tockbot-note-vault": "workspace:0.6.0",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
