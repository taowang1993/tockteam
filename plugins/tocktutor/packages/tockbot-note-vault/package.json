{
  "name": "tockbot-note-vault",
  "version": "0.6.0",
  "description": "Read-only note vault tools for Tockbot",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./inspection": {
      "types": "./inspection.d.ts",
      "import": "./inspection.js",
      "default": "./inspection.js"
    }
  },
  "files": [
    "index.js",
    "inspection.js",
    "inspection.d.ts",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check index.js && node --test"
  },
  "dependencies": {
    "schemastery": "^3.18.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
