{
  "name": "@tockteam/tocktutor-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter='!@tockteam/tocktutor-workspace' --if-present run build",
    "pretest": "pnpm run validate:parity && node ../../scripts/prepare-tocktutor-desktop-artifact.mjs",
    "test": "pnpm -r --filter='!@tockteam/tocktutor-workspace' --if-present run test",
    "typecheck": "pnpm -r --filter='!@tockteam/tocktutor-workspace' --if-present run typecheck",
    "validate:parity": "node parity/validate.mjs"
  }
}
