{
  "schemaVersion": 1,
  "identity": {
    "packageName": "@tockteam/desktop",
    "productName": "TockTeam Desktop",
    "appId": "ai.deepseek.tockteam-desktop",
    "executableName": "tockteam-desktop",
    "desktopName": "tockteam-desktop.desktop",
    "protocols": [
      "tocktutor"
    ],
    "dataDirectory": "TockTeam-Desktop"
  },
  "targets": [
    {
      "platform": "mac",
      "formats": [
        "dmg",
        "zip"
      ],
      "architectures": [
        "arm64",
        "x64"
      ]
    },
    {
      "platform": "linux",
      "formats": [
        "AppImage",
        "deb"
      ],
      "architectures": [
        "arm64",
        "x64"
      ]
    },
    {
      "platform": "win",
      "formats": [
        "dir"
      ],
      "architectures": [
        "x64"
      ]
    }
  ],
  "resources": {
    "asar": true,
    "npmFiles": [
      "dist/plugin.js",
      "dist/client.js",
      "dist/client.js.map",
      "dist/client-api.js",
      "client.d.ts",
      "dist/host.js",
      "host.d.ts",
      "dist/cordis.patch.yml",
      "plugins/tocktutor/README.md",
      "plugins/tocktutor/packages/*/package.json",
      "plugins/tocktutor/packages/*/cordis.patch.yml",
      "plugins/tocktutor/packages/*/lib/**",
      "plugins/tocktutor/packages/*/dist/**",
      "plugins/tocktutor/packages/tockbot-note-vault/index.js",
      "plugins/tocktutor/packages/tockbot-note-vault/inspection.js",
      "plugins/tocktutor/packages/tockbot-note-vault/inspection.d.ts",
      "plugins/tocktutor/packages/tockbot-note-vault/LICENSE",
      "plugins/tocktutor/packages/tockbot-note-vault/README.md",
      "plugins/tocktutor/packages/tockteam-tocktutor-assistant/PENNIVO_PROVENANCE.md",
      "plugins/tocktutor/packages/tockteam-tocktutor-assistant/THIRD_PARTY_NOTICES",
      "plugins/tocktutor/packages/tockteam-tocktutor-import-export/README.md",
      "dist/tockteam.js",
      "bin/tockteam",
      "bin/tockteam.cmd"
    ],
    "builderFiles": [
      "dist/main.js",
      "dist/preload.cjs",
      "dist/splash.html",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "builderExtraResources": [
      {
        "from": ".stage",
        "to": ".",
        "filter": [
          "dsh-runtime/**/*",
          "node-runtime/**/*"
        ]
      },
      {
        "from": "assets/icons/512x512.png",
        "to": "tockteam-desktop.png"
      },
      {
        "from": "dist/tockteam.js",
        "to": "lib/tockteam/cli.js"
      },
      {
        "from": "dist/release-package.json",
        "to": "lib/tockteam/package.json"
      },
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "tockteam",
          "tockteam.cmd"
        ]
      }
    ]
  },
  "launcherLockfile": {
    "path": "pnpm-lock.yaml",
    "rootImporter": {
      "fuse.js": {
        "specifier": "7.1.0",
        "version": "7.1.0"
      },
      "fuzzysort": {
        "specifier": "3.1.0",
        "version": "3.1.0"
      }
    },
    "packages": {
      "fuse.js@7.1.0": {
        "integrity": "sha512-trLf4SzuuUxfusZADLINj+dE8clK1frKdmqiJNb1Es75fmI5oY6X2mxLVUciLLjxqw/xr72Dhy+lER6dGd02FQ=="
      },
      "fuzzysort@3.1.0": {
        "integrity": "sha512-sR9BNCjBg6LNgwvxlBd0sBABvQitkLzoVY9MYYROQVX/FvfJ4Mai9LsGhDgd8qYdds0bY77VzYd5iuB+v5rwQQ=="
      }
    },
    "snapshots": {
      "fuse.js@7.1.0": {},
      "fuzzysort@3.1.0": {}
    }
  },
  "foundation": {
    "launcherImplemented": true,
    "launcherPackaged": false,
    "admittedRuntimeDependencies": [
      "fuse.js@7.1.0",
      "fuzzysort@3.1.0"
    ],
    "runtimeDependencyClosure": [
      "fuse.js@7.1.0",
      "fuzzysort@3.1.0"
    ],
    "launcherAssets": [],
    "launcherNotices": [],
    "shippedVendorSource": false,
